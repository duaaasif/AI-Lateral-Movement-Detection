{
  "paths": {
    "raw_dir": "data/raw",
    "processed_file": "data/processed/clean_logs.csv",
    "ground_truth_file": "data/raw/ground_truth_campaigns.csv",
    "features_file": "data/features/feature_table.csv",
    "alerts_dir": "data/alerts",
    "rule_alerts_file": "data/alerts/alerts.csv",
    "ml_alerts_file": "data/alerts/ml_alerts.csv",
    "all_alerts_file": "data/alerts/all_alerts.csv",
    "user_risk_file": "data/alerts/user_risk_scores.csv",
    "eval_report_file": "data/alerts/evaluation_report.json",
    "visualizations_dir": "data/alerts/visualizations",
    "models_dir": "models"
  },
  "features": {
    "time_window": "10min",
    "default_year": 2025,
    "work_hours_start": 6,
    "work_hours_end": 18,
    "suspicious_processes": [
      "powershell.exe",
      "cmd.exe",
      "wmic.exe",
      "psexec.exe",
      "net.exe",
      "schtasks.exe",
      "rundll32.exe",
      "wscript.exe"
    ],
    "admin_share_keywords": [
      "c$",
      "admin$",
      "ipc$",
      "f$",
      "net use",
      "smb"
    ],
    "lateral_ports": [22, 135, 445, 3389, 5985]
  },
  "rules": {
    "multi_host_window_minutes": 10,
    "failed_login_burst_threshold": 3,
    "failed_login_window_minutes": 10,
    "sensitive_hosts": {
      "hr01": ["sara", "hr_admin"],
      "hr02": ["sara", "hr_admin"],
      "finance01": ["ali", "fin_admin"],
      "finance02": ["ali", "fin_admin"],
      "dc01": ["admin_ops"],
      "db01": ["dba_admin", "admin_ops"],
      "linux-prod01": ["admin_ops", "eng_lead"],
      "linux-db01": ["dba_admin", "admin_ops"]
    },
    "severities": {
      "Multiple hosts in short time": 0.75,
      "Login outside working hours": 0.55,
      "Remote process creation": 0.70,
      "Sensitive host access": 0.85,
      "Failed login burst before success": 0.85,
      "Admin share access": 0.80
    }
  },
  "ml": {
    "contamination": 0.0005,
    "random_state": 42,
    "max_if_train_samples": 50000
  },
  "ensemble": {
    "weights": {
      "Rule-based": 0.55,
      "ML": 0.45
    },
    "risk_thresholds": {
      "CRITICAL": 75,
      "HIGH": 55,
      "MEDIUM": 35
    }
  }
}
